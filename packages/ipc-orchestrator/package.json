{
  "name": "ipc-orchestrator",
  "version": "0.1.0",
  "description": "Transport-agnostic orchestration layer for multi-agent request/reply",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./adapters/ipc": {
      "types": "./dist/adapters/ipc.d.ts",
      "default": "./dist/adapters/ipc.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "dependencies": {
    "ipc": "^0.1.0"
  },
  "devDependencies": {
    "typescript": "^5.4.5",
    "@types/node": "^22.13.1"
  }
}
